# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- 数据集（体积大且受 Twitter 服务条款约束，不入库）----
data/raw/
data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep

# ---- 训练产物 ----
outputs/
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
runs/
wandb/

# ---- LLM 权重缓存 ----
# 注意：这里必须用前导斜杠锚定到仓库根目录！
# 写成 `models/` 会匹配任意层级的同名目录，把 src/models/（模型层源码）
# 一起忽略掉，而 git status 不会给出任何提示——这是最危险的一类 gitignore 陷阱。
/models/
/checkpoints/
*.gguf

# ---- 日志与临时文件 ----
*.log
/logs/
tmp/
temp/
*.tmp

# ---- 测试与自检脚本的临时目录 ----
# scripts/run_pure_python_tests.py 把每个用例的工作目录建在仓库内的
# .tmp_pure_tests/ 下（放在仓库内是为了避开某些沙箱对系统临时目录的限制），
# 跑完会自动删除；这里再兜一层，避免异常中断时把临时文件提交进去。
.tmp*/
**/.tmp*/

# ---- 密钥 ----
.env
.env.*
*.key
*.pem

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
